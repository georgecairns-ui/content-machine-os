# Built zips
dist/

# Safety copies the app makes before every save, and the half-written file a save is in the middle of
*.backup.json
*.saving
apps/content/data/*.tmp-*

# A customer's own skill, built from their research, and its zip: never ships
.claude/skills/*-what-works/
skills-to-upload/*.zip

# Computer clutter
.DS_Store
._*
Thumbs.db
desktop.ini

# Local Claude Code files that belong to one computer, not the kit
.claude/launch.json
.claude/settings.local.json
.claude/.cc-writes/

# Home layout: one person's choice of boxes, made while testing
apps/home/data/
__pycache__/
*.pyc

# Photos and videos added to posts: they stay on this computer, never in the kit
apps/*/data/media/

# The saved download of each tool as a customer installed it: theirs, not the kit's
setup/as-installed/*
!setup/as-installed/README.md
